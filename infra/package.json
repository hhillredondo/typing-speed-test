{
  "name": "typing-speed-test-infra",
  "version": "1.0.0",
  "private": true,
  "description": "AWS CDK infrastructure for typing-speed-test",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "cdk": "cdk",
    "synth": "cdk synth",
    "deploy:dev": "cdk deploy typing-speed-dev --require-approval never",
    "destroy:dev": "cdk destroy typing-speed-dev --force",
    "test": "jest"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "aws-cdk": "^2.1141.0",
    "jest": "^30.5.2",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/test/**/*.test.js"
    ]
  },
  "dependencies": {
    "aws-cdk-lib": "^2.170.0",
    "constructs": "^10.3.0"
  }
}
