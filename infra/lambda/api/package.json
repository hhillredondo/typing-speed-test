{
  "name": "typing-speed-api",
  "private": true,
  "description": "Typing speed REST API Lambda. Bundled with esbuild so aws-jwt-verify ships with the function.",
  "dependencies": {
    "aws-jwt-verify": "^5.2.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "scripts": {
    "build": "esbuild index.js --bundle --platform=node --target=node22 --format=cjs --outfile=dist/index.js --external:@aws-sdk/* --sourcemap"
  }
}
